# ============================================================
# 人话翻译局 · 环境变量示例
# 复制为 .env（本地开发）或在部署平台里逐项配置。
# 前端只读取 VITE_ 开头的变量；AI 密钥永远只在服务端使用。
# ============================================================

# ---------- 服务端（server/index.mjs）---------- 
# 服务监听端口。前端开发服务器（5190）会把 /api 代理到这里。
PORT=8787

# 模型密钥。留空 = 关闭 AI，前端自动使用本地离线引擎（功能完整，可离线演示）。
# 绝对不要把真实密钥写进 .env.example、前端代码或 git 仓库。
AI_API_KEY=

# OpenAI 兼容接口地址（DeepSeek / OpenAI / Moonshot / 自建网关都适用）。
# 例：https://api.deepseek.com/v1
AI_BASE_URL=https://api.deepseek.com/v1

# 模型名。例：deepseek-chat / gpt-4o-mini
AI_MODEL=deepseek-chat

# 供应商适配器：openai-compatible（默认）| mock（仅测试用，不联网）
AI_PROVIDER=openai-compatible

# 单次请求超时（毫秒）
AI_TIMEOUT_MS=25000

# 温度（0~1，越大越发散）
AI_TEMPERATURE=0.9

# 简易限流：每个 IP 每分钟最多请求数（0 = 不限）
RATE_LIMIT_PER_MIN=20

# 部署 dist/ 时，把前端静态文件也交给这个服务托管（同源部署最省事）
SERVE_STATIC=true

# ---------- 前端（Vite，构建时注入）----------
# 开发期 /api 代理目标，默认 http://127.0.0.1:8787
# VITE_API_ORIGIN=http://127.0.0.1:8787
